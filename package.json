{
  "name": "dsh-career",
  "version": "0.1.0",
  "private": true,
  "description": "CareerOS — personal AI career intelligence & internship management system (local-first SQLite, agent tools + Web dashboard)",
  "type": "module",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/wrapped-bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "client",
    "scripts",
    "docs",
    "locale",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT"
}
